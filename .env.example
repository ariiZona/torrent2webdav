# Copy this file to .env and adjust.
# BitTorrent listen and published port, TCP and UDP.
TORRENT_PORT=42069
# Max upload speed to peers (bytes/s with K/M/G suffixes; 0 = unlimited).
# UPLOAD_RATE=1M
# Fully cache a file after this many bytes were read through WebDAV (0 = never).
# FULL_CACHE_AFTER=250M
